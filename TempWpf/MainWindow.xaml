<Window x:Class="TempWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TempWpf"
        mc:Ignorable="d"
        Title="TempWPF" Height="450" Width="800" Background="#FF3F7EF9">
    <Grid Background="#FFAACEFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84*"/>
            <ColumnDefinition Width="503*"/>
            <ColumnDefinition Width="213*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="20,20,20,20" Grid.ColumnSpan="3">
            <Button Name="StartStopBtn" Click="StartStopBtn_Click" Content="Старт" Width="124" FontWeight="Bold" Height="44" BorderBrush="#FF082D9E" Foreground="#FF4E60C3" Background="#FFBEE7F1"/>
            <TextBlock Name="StatusText" Margin="10" FontWeight="Bold" Foreground="#FF272E69"/>
        </StackPanel>
    </Grid>
</Window>
